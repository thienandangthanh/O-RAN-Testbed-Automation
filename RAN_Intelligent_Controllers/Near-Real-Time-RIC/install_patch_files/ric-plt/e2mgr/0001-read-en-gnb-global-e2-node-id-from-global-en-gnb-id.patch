@@ -24,12 +24,12 @@
                         <value>
                             <GlobalE2node-ID>
                                 <en-gNB>
-                                    <global-gNB-ID>
+                                    <global-en-gNB-ID>
                                         <pLMN-Identity>13 10 14</pLMN-Identity>
                                         <gNB-ID>
                                             <gNB-ID>11000101110001101100011111111000</gNB-ID>
                                         </gNB-ID>
-                                    </global-gNB-ID>
+                                    </global-en-gNB-ID>
                                 </en-gNB>
                             </GlobalE2node-ID>
                         </value>
