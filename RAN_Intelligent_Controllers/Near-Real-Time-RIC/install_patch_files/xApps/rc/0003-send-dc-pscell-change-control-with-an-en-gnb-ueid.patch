--- a/control/rcService.go
+++ b/control/rcService.go
@@ -1,6 +1,8 @@
 package control
 
 import (
+	"errors"
+	"fmt"
 	"log"
 	"regexp"
 	"runtime/debug"
@@ -15,12 +17,66 @@ import (
 )
 
 // TargetCellID is the TS xApp's cell key: the 36-bit NR Cell Identity in 9 hex digits followed by its 4 unused
-// bits as hex 0. plmnID is the E2 node's PLMN Identity, 3 octets in hex (3GPP TS 38.413 9.3.3.5).
+// bits as hex 0. plmnID is the E2 node's PLMN Identity, 3 octets in hex (3GPP TS 38.413 9.3.3.5). The en-gNB-UEID
+// members are the MeNB UE X2AP ID (INTEGER (0..4095), 3GPP TS 36.423 9.2.24) and the master eNB's Global eNB ID:
+// its PLMN Identity in 6 hex digits and its 20-bit macro eNB ID in 5 hex digits.
 var (
 	targetCellKeyRe = regexp.MustCompile(`^[0-9A-F]{9}0$`)
 	plmnIDRe        = regexp.MustCompile(`^[0-9A-Fa-f]{6}$`)
+	macroEnbIDRe    = regexp.MustCompile(`^[0-9A-Fa-f]{5}$`)
 )
 
+const maxEnbUeX2apID = 4095
+
+// validateRicControlGrpcReq admits only a CONTROL Style 5 action 3 request (DC PSCell Change control, E2SM-RC
+// v03.00 7.6.6.1) whose UE ID is exactly an en-gNB-UEID with every member in range, addressed to an E2 node and
+// naming an NR target cell. It reads every message through the nil-safe getters, so a request with any member
+// missing is refused instead of dereferencing it. The error names the first problem found.
+func validateRicControlGrpcReq(r *rc.RicControlGrpcReq) error {
+	if r == nil {
+		return errors.New("no request")
+	}
+	if r.GetE2NodeID() == "" || r.GetRanName() == "" || !plmnIDRe.MatchString(r.GetPlmnID()) {
+		return errors.New("e2NodeID and ranName must be set and plmnID must be 6 hex digits")
+	}
+	e2ap := r.GetRICE2APHeaderData()
+	if e2ap == nil || e2ap.GetRanFuncId() < 0 || e2ap.GetRICRequestorID() < 0 {
+		return errors.New("RICE2APHeaderData with a non-negative RanFuncId and RICRequestorID is required")
+	}
+	hdr := r.GetRICControlHeaderData()
+	if hdr == nil {
+		return errors.New("RICControlHeaderData is required")
+	}
+	if hdr.GetControlStyle() != RIC_CONTROL_STYLE_DUAL_CONNECTIVITY ||
+		hdr.GetControlActionId() != RIC_CONTROL_ACTION_DC_PSCELL_CHANGE {
+		return fmt.Errorf("ControlStyle %d / ControlActionId %d: only style 5 / action 3 (DC PSCell Change control) is sent",
+			hdr.GetControlStyle(), hdr.GetControlActionId())
+	}
+	ueID := hdr.GetUEID()
+	if ueID.GetGnbUEID() != nil {
+		return errors.New("UEID must carry EnGnbUEID only, not GnbUEID")
+	}
+	en := ueID.GetEnGnbUEID()
+	if en == nil {
+		return errors.New("UEID.EnGnbUEID is required")
+	}
+	if en.GetMEnbUeX2ApId() < 0 || en.GetMEnbUeX2ApId() > maxEnbUeX2apID {
+		return fmt.Errorf("EnGnbUEID.mEnbUeX2apId %d is outside 0..%d", en.GetMEnbUeX2ApId(), maxEnbUeX2apID)
+	}
+	if !plmnIDRe.MatchString(en.GetGlobalEnbPlmn()) {
+		return fmt.Errorf("EnGnbUEID.globalEnbPlmn %q is not 6 hex digits", en.GetGlobalEnbPlmn())
+	}
+	if !macroEnbIDRe.MatchString(en.GetGlobalEnbMacroId()) {
+		return fmt.Errorf("EnGnbUEID.globalEnbMacroId %q is not 5 hex digits (a 20-bit macro eNB ID)",
+			en.GetGlobalEnbMacroId())
+	}
+	msg := r.GetRICControlMessageData()
+	if msg == nil || !targetCellKeyRe.MatchString(msg.GetTargetCellID()) {
+		return errors.New("TargetCellID must be 9 hex digits of NR Cell Identity followed by 0")
+	}
+	return nil
+}
