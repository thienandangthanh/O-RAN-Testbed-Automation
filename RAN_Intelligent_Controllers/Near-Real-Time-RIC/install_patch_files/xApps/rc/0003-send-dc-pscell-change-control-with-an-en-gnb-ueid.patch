index 0000000..6bfd4c2
--- /dev/null
+++ b/control/rcService_test.go
@@ -0,0 +1,70 @@
+package control
+
+import (
+	"strings"
+	"testing"
+
+	"gerrit.o-ran-sc.org/r/ric-app/rc/protocol/grpc/ricmsgcommrpc/rc"
+)
+
+// validReq is a DC PSCell Change control (style 5, action 3) for the UE with MeNB UE X2AP ID 5 at macro eNB 1,
+// sent to en-gNB 2 and naming gNB 3's NR cell, as the TS xApp builds it.
+func validReq() *rc.RicControlGrpcReq {
+	return &rc.RicControlGrpcReq{
+		E2NodeID:          "00000002",
+		PlmnID:            "00F110",
+		RanName:           "en_gnb_001_001_00000002",
+		RICE2APHeaderData: &rc.RICE2APHeader{RanFuncId: 3, RICRequestorID: 1},
+		RICControlHeaderData: &rc.RICControlHeader{ControlStyle: 5, ControlActionId: 3,
+			UEID: &rc.UeId{EnGnbUEID: &rc.EnGNBUEID{MEnbUeX2ApId: 5, GlobalEnbPlmn: "00F110", GlobalEnbMacroId: "00001"}}},
+		RICControlMessageData: &rc.RICControlMessage{TargetCellID: "0000000030"},
+	}
+}
+
+func TestValidateAdmitsStyle5Action3WithEnGnbUEID(t *testing.T) {
+	if err := validateRicControlGrpcReq(validReq()); err != nil {
+		t.Fatalf("valid request refused: %v", err)
+	}
+	r := validReq()
+	r.RICControlHeaderData.UEID.EnGnbUEID = &rc.EnGNBUEID{MEnbUeX2ApId: 4095, GlobalEnbPlmn: "00f110", GlobalEnbMacroId: "fffff"}
+	if err := validateRicControlGrpcReq(r); err != nil {
+		t.Fatalf("X2AP ID 4095 / macro eNB ID FFFFF refused: %v", err)
+	}
+}
+
+func TestValidateRefusesWithoutDereferencingNilMembers(t *testing.T) {
+	cases := map[string]func(r *rc.RicControlGrpcReq){
+		"nil request":    nil,
+		"no UEID":        func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID = nil },
+		"neither UE ID":  func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID = &rc.UeId{} },
+		"GnbUEID only":   func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID = &rc.UeId{GnbUEID: &rc.GNBUEID{}} },
+		"both UE IDs":    func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.GnbUEID = &rc.GNBUEID{} },
+		"no header":      func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData = nil },
+		"no message":     func(r *rc.RicControlGrpcReq) { r.RICControlMessageData = nil },
+		"no E2AP header": func(r *rc.RicControlGrpcReq) { r.RICE2APHeaderData = nil },
+		"style 3 action 1": func(r *rc.RicControlGrpcReq) {
+			r.RICControlHeaderData.ControlStyle, r.RICControlHeaderData.ControlActionId = 3, 1
+		},
+		"style 5 action 4":         func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.ControlActionId = 4 },
+		"X2AP ID 4096":             func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.MEnbUeX2ApId = 4096 },
+		"X2AP ID -1":               func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.MEnbUeX2ApId = -1 },
+		"PLMN of 5 digits":         func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.GlobalEnbPlmn = "00F11" },
+		"PLMN not hex":             func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.GlobalEnbPlmn = "00F1G0" },
+		"macro eNB ID of 6 digits": func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.GlobalEnbMacroId = "100000" },
+		"macro eNB ID empty":       func(r *rc.RicControlGrpcReq) { r.RICControlHeaderData.UEID.EnGnbUEID.GlobalEnbMacroId = "" },
+		"target not a cell key":    func(r *rc.RicControlGrpcReq) { r.RICControlMessageData.TargetCellID = "0000000303" },
+		"no E2 node":               func(r *rc.RicControlGrpcReq) { r.E2NodeID = "" },
+		"no RAN name":              func(r *rc.RicControlGrpcReq) { r.RanName = "" },
+	}
+	for name, mutate := range cases {
+		var r *rc.RicControlGrpcReq
+		if mutate != nil {
+			r = validReq()
+			mutate(r)
+		}
+		err := validateRicControlGrpcReq(r)
+		if err == nil || strings.TrimSpace(err.Error()) == "" {
+			t.Errorf("%s: admitted", name)
+		}
+	}
+}
