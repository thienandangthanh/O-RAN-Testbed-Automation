+// kpmFormat2UeIdTag returns the ueId tag of the UE at position ueIndex of a KPM Indication Message Format 2
+// (e2sm_kpm_format2_ue_id_tag), or the reason it has none.
+func kpmFormat2UeIdTag(msg *C.E2SM_KPM_IndicationMessage_Format2_t, ueIndex int32) (string, error) {
+	var buf [128]C.char
+	n := C.e2sm_kpm_format2_ue_id_tag(msg, C.size_t(ueIndex), &buf[0], C.size_t(len(buf)))
+	text := C.GoString(&buf[0])
+	if n < 0 {
+		return "", errors.New(text)
+	}
+	return text, nil
+}
