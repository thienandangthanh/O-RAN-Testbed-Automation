+// KPM subscription parameters (ms): the E2SM-KPM event trigger's reportingPeriod
+// and the action definitions' granulPeriod. They come from the controls section
+// of the xApp descriptor (deploy/config.json, written by
+// install_xapp_kpi_monitor.sh), which dms_cli mounts at xappDescriptorPath;
+// xapp.Config reads the image's CFG_FILE (/opt/config-file.yaml) instead.
+const xappDescriptorPath = "/opt/ric/config/config-file.json"
+
+var reportingPeriodMs, granularityPeriodMs uint32
+
+// loadKpmControls reads controls.reportingPeriodMs and controls.granularityPeriodMs
+// (integers 1..4294967295, required) from the xApp descriptor at path.
+func loadKpmControls(path string) (uint32, uint32, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return 0, 0, fmt.Errorf("reading the xApp descriptor: %v", err)
+	}
+	var d struct {
+		Controls struct {
+			ReportingPeriodMs   *uint32 `json:"reportingPeriodMs"`
+			GranularityPeriodMs *uint32 `json:"granularityPeriodMs"`
+		} `json:"controls"`
+	}
+	if err = json.Unmarshal(raw, &d); err != nil {
+		return 0, 0, fmt.Errorf("%s: controls.reportingPeriodMs/granularityPeriodMs: %v", path, err)
+	}
+	rp, gp := d.Controls.ReportingPeriodMs, d.Controls.GranularityPeriodMs
+	if rp == nil || gp == nil || *rp == 0 || *gp == 0 {
+		return 0, 0, fmt.Errorf("%s: controls.reportingPeriodMs and controls.granularityPeriodMs must be positive integers", path)
+	}
+	return *rp, *gp, nil
+}
+
+// encodeEventTrigger APER-encodes an E2SM-KPM-EventTriggerDefinition Format 1
+// with the given reporting period (kpimon's own E2SM library).
+func encodeEventTrigger(periodMs uint32) (clientmodel.EventTriggerDefinition, error) {
+	var buf [16]C.uchar
+	n := C.e2sm_encode_kpm_event_trigger_format1(unsafe.Pointer(&buf[0]), C.size_t(len(buf)), C.ulong(periodMs))
+	if n <= 0 {
+		return nil, fmt.Errorf("cannot encode an event trigger with reportingPeriod %d ms", periodMs)
+	}
+	trigger := make(clientmodel.EventTriggerDefinition, 0, int(n))
+	for i := 0; i < int(n); i++ {
+		trigger = append(trigger, int64(buf[i]))
+	}
+	return trigger, nil
+}
+
