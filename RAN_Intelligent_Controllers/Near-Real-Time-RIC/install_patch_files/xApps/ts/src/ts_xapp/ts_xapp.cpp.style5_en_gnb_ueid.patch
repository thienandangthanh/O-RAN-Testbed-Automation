+// Influx v2 response body sink (libcurl write callback).
+static size_t influx_body_cb( char *in, size_t size, size_t num, string *out ) {
+  out->append( in, size * num );
+  return size * num;
+}
 
+/*
+  True if at least one UeMetrics point in the bucket carries exactly the ueId tag `tag` within kUeMetricsWindow.
+  The Flux query names only the measurement, the ueId tag and the time. It keeps only _time before group():
+  kpimon writes integer and float fields, and grouping their _value columns into one table is a schema
+  collision that InfluxDB answers with HTTP 400. `tag` must already be a parsed
+  en-gNB-UEID tag (digits, uppercase hex, ':', '@', '-'), so it needs no escaping inside the Flux string.
+  On any error returns false and writes the reason to why; the token is never logged.
+*/
+bool ue_has_metrics_row( const string &tag, string &why ) {
+  if( !influx.ok() ) {
+    why = "Influx is not configured (descriptor controls influx_url, influx_org, influx_bucket, influx_token)";
+    return false;
+  }
+  CURL *curl = curl_easy_init();
+  if( curl == NULL ) {
+    why = "curl_easy_init failed";
+    return false;
+  }
+  char *org = curl_easy_escape( curl, influx.org.c_str(), 0 );
+  const string url = influx.url + "/api/v2/query?org=" + ( org ? org : "" );
+  curl_free( org );
+  const string flux = "from(bucket: \"" + influx.bucket + "\")"
+                      " |> range(start: " + kUeMetricsWindow + ")"
+                      " |> filter(fn: (r) => r._measurement == \"UeMetrics\" and r.ueId == \"" + tag + "\")"
+                      " |> keep(columns: [\"_time\"]) |> group() |> limit(n: 1)";
+  const string auth = "Authorization: Token " + influx.token;
+  struct curl_slist *headers = NULL;
+  headers = curl_slist_append( headers, auth.c_str() );
+  headers = curl_slist_append( headers, "Content-Type: application/vnd.flux" );
+  headers = curl_slist_append( headers, "Accept: application/csv" );
+  string body;
+  char errbuf[CURL_ERROR_SIZE] = { 0 };
+  long status = 0;
+  CURLcode res = CURLE_OK;
+  if( headers == NULL ||
+      ( res = curl_easy_setopt( curl, CURLOPT_URL, url.c_str() ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_HTTPHEADER, headers ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_POSTFIELDS, flux.c_str() ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_TIMEOUT, 5L ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_ERRORBUFFER, errbuf ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_WRITEFUNCTION, influx_body_cb ) ) != CURLE_OK ||
+      ( res = curl_easy_setopt( curl, CURLOPT_WRITEDATA, &body ) ) != CURLE_OK ||
+      ( res = curl_easy_perform( curl ) ) != CURLE_OK ||
+      ( res = curl_easy_getinfo( curl, CURLINFO_RESPONSE_CODE, &status ) ) != CURLE_OK ) {
+    why = string( "Influx query failed: " ) + ( errbuf[0] ? errbuf : curl_easy_strerror( res ) );
+  }
+  curl_slist_free_all( headers );
+  curl_easy_cleanup( curl );
+  if( !why.empty() ) return false;
+  if( status != 200 ) {
+    why = "Influx query answered HTTP " + to_string( status ) + ": " + body.substr( 0, 200 );
+    return false;
+  }
+  // HTTP 200 may still carry an error table: the CSV structure decides (influx_csv.hpp)
+  string csvWhy;
+  if( !ts::influx_csv_has_time_record( body, csvWhy ) ) {
+    why = string( "no UeMetrics point with this ueId tag in the last " ) + ( kUeMetricsWindow + 1 ) + " (" + csvWhy +
+          ")";
+    return false;
+  }
+  return true;
+}
